  "cards": [
    {
      "dot": "cyan",
      "title": "发送语义",
      "items": [
        "业务通道 13 表示 voice assistant",
        "AssistantMsg type 5 表示 ASR 文本",
        "CoreConnect 再封装 deviceId、business enum 和 messageId"
      ]
    },
    {
      "dot": "violet",
      "title": "接收语义",
      "items": [
        "沿用原插件 delegate 将原始事件转换为 Map",
