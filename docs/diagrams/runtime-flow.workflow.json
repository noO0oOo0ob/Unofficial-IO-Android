{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Unofficial IO Android 自包含运行流程",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "viewBox": [1200, 720]
  },
  "lanes": [
    { "id": "app", "label": "Android 主应用" },
    { "id": "runtime", "label": "内置运行时" },
    { "id": "security", "label": "完整性与事件缓冲" },
    { "id": "device", "label": "设备通信" },
    { "id": "hardware", "label": "物理设备" }
  ],
  "phases": [
    { "id": "startup", "label": "启动准备", "fromCol": 0, "toCol": 1 },
    { "id": "bootstrap", "label": "安全装载", "fromCol": 2, "toCol": 3, "variant": "security" },
    { "id": "control", "label": "初始化与控制", "fromCol": 4, "toCol": 5, "variant": "emphasis" }
  ],
  "mainPath": ["apk", "permission", "extract", "verify", "classloader", "core", "command", "glasses"],
  "semanticChecks": {
    "allowedRoots": ["apk"],
    "allowedTerminals": ["glasses", "ui_event"],
    "requiredPaths": [
      { "from": "apk", "to": "core" },
      { "from": "command", "to": "glasses" },
      { "from": "glasses", "to": "ui_event" }
    ]
  },
  "nodes": [
    { "id": "apk", "lane": "app", "col": 0, "type": "frontend", "label": "单一 APK", "sublabel": "主程序 + vendor DEX + arm64 SO", "width": 156 },
    { "id": "permission", "lane": "app", "col": 1, "type": "security", "label": "请求蓝牙权限", "sublabel": "标准 Android Runtime Permission", "width": 156 },
    { "id": "extract", "lane": "runtime", "col": 2, "type": "backend", "label": "释放内置 DEX", "sublabel": "仅写入本应用 code_cache", "width": 156 },
    { "id": "verify", "lane": "security", "col": 2, "type": "security", "label": "校验并只读化", "sublabel": "SHA-256 + read-only", "tag": "版本锁定 1.0.1 (61)", "width": 156 },
    { "id": "classloader", "lane": "runtime", "col": 3, "type": "backend", "label": "DexClassLoader", "sublabel": "加载 APK 自带代码与 native 库", "width": 156 },
    { "id": "core", "lane": "runtime", "col": 4, "type": "backend", "label": "初始化 CoreConnect", "sublabel": "注册 5 类事件 delegate", "width": 168 },
    { "id": "command", "lane": "device", "col": 5, "type": "messagebus", "label": "设备操作", "sublabel": "扫描、连接、断开、发送", "width": 156 },
    { "id": "glasses", "lane": "hardware", "col": 5, "type": "external", "label": "RayNeo 眼镜", "sublabel": "BLE 链路", "width": 156 },
    { "id": "event_queue", "lane": "security", "col": 4, "type": "messagebus", "label": "SDK 事件队列", "sublabel": "原 delegate 转为 Map", "width": 156 },
    { "id": "ui_event", "lane": "app", "col": 5, "type": "frontend", "label": "UI 展示事件", "sublabel": "350 ms 定时排空队列", "width": 156 }
  ],
  "edges": [
    { "id": "launch", "from": "apk", "to": "permission", "label": "启动", "variant": "default", "role": "main" },
    { "id": "prepare", "from": "permission", "to": "extract", "label": "点击初始化", "variant": "emphasis", "role": "main" },
    { "id": "integrity", "from": "extract", "to": "verify", "label": "逐文件校验", "variant": "security", "role": "main" },
    { "id": "load", "from": "verify", "to": "classloader", "label": "仅校验通过后加载", "variant": "security", "role": "main" },
    { "id": "bootstrap_core", "from": "classloader", "to": "core", "label": "反射固定 ABI", "variant": "emphasis", "role": "main" },
    { "id": "expose_actions", "from": "core", "to": "command", "label": "暴露控制 API", "variant": "emphasis", "role": "main", "route": "outside-right" },
    { "id": "ble_control", "from": "command", "to": "glasses", "label": "BLE 命令与业务消息", "variant": "emphasis", "role": "main" },
    { "id": "device_events", "from": "glasses", "to": "event_queue", "label": "发现、连接、消息事件", "variant": "default", "role": "return" },
    { "id": "poll_events", "from": "event_queue", "to": "ui_event", "label": "排空并回调", "variant": "dashed", "role": "async" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "应用边界",
      "items": [
        "不查询、不启动、不控制官方 RayNeo AI App",
        "代码、native 库和运行时文件全部位于自身 APK 或私有目录",
        "只使用普通蓝牙权限，不需要 root 或 bootloader 解锁"
      ]
    },
    {
      "dot": "amber",
      "title": "兼容性边界",
      "items": [
        "反射 ABI 与 RayNeo AI 1.0.1 (61) 强绑定",
        "当前仅打包 arm64-v8a",
        "真机握手仍需连接手机与眼镜验证"
      ]
    }
  ]
}
